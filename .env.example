# RivetMSP — Docker Compose configuration.
# Copy to .env and fill in: cp .env.example .env

# Host port the app is published on. Visit http://localhost:<this>/ once
# `docker compose up -d` finishes; it will redirect you to /setup.
APP_PORT=8080

# MariaDB credentials — pick your own values, then in the setup wizard's
# "Connect your Database" step use host "db", database/user/password
# matching these.
DB_NAME=itflow
DB_USER=itflow
DB_PASSWORD=change-me-to-something-random
DB_ROOT_PASSWORD=change-me-too-something-else-random

# The UID/GID php-fpm and nginx run as inside the container, remapped from
# the image default (33, i.e. www-data) so the app can write config.php and
# uploads/ into this bind-mounted checkout. Set these to the user who ran
# `git clone` — run `id -u` / `id -g` on the host to find them. Left at the
# default 33/33, this only works if this checkout happens to be writable by
# uid/gid 33 already, which it normally isn't.
DOCKER_UID=1000
DOCKER_GID=1000

# Only used if you set RESTORE_FROM below — otherwise a fresh install gets
# this interactively from the /setup wizard. If you're putting a reverse
# proxy in front with a real domain, set this to match it.
APP_BASE_URL=localhost:8080

# Restoring a deploy/backup.sh backup on first boot, instead of a fresh
# install: put the two files it names below under ./restore/ on the host
# (that directory is always bind-mounted into the container, read-only, at
# /var/www/restore — see docker-compose.yml), then set both of these to
# their in-container paths. Leave both commented out/empty for a normal
# fresh install via the browser /setup wizard.
# RESTORE_FROM=/var/www/restore/backup-itflow-20260101T000000Z.tar.gz.enc
# RESTORE_PASSPHRASE_FILE=/var/www/restore/passphrase
